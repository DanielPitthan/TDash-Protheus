#include 'tlpp-core.th'
#include 'totvs.ch'

// Profundidade máxima da hierarquia (protege contra visão com linha superior em ciclo)
#define MAX_DEPTH 10

namespace tdash.ctb

/*/{Protheus.doc} u_rollup
Totaliza as linhas de uma Visão Gerencial.
Linha analítica (classe diferente de "1") vale o saldo próprio, já na natureza da linha. Linha sintética
(classe "1") vale a soma das linhas filhas (as que a têm como superior): a filha de mesma natureza soma e a de
natureza oposta subtrai. É assim que a DRE sai: receita bruta (credora) menos deduções (devedora), e assim por diante.
@type user function
@author TDash
@since 21/10/2026
@param aLines, array, linhas { chave, chave da superior, classe, natureza, saldo próprio }; chaves sem espaços
@return array, { { chave, valor, nível } } na mesma ordem das linhas; nível 0 = sem superior
/*/
User Function rollup(aLines as array) as array
    local aResult := {} as array
    local nX      := 0 as numeric

    for nX := 1 to Len(aLines)
        aAdd(aResult, { aLines[nX][1], 0, 0 })
    next nX

    for nX := 1 to Len(aLines)
        aResult[nX][2] := lineValue(aLines, nX, 0)
        aResult[nX][3] := lineLevel(aLines, nX)
    next nX
return aResult

/*/{Protheus.doc} lineValue
Valor de uma linha: o saldo próprio (analítica) ou a soma das filhas com o sinal pela natureza (sintética).
@type static function
@author TDash
@since 21/10/2026
@param aLines, array, linhas
@param nIdx, numeric, posição da linha
@param nDepth, numeric, profundidade atual (limite MAX_DEPTH)
@return numeric, valor na natureza da linha
/*/
static function lineValue(aLines as array, nIdx as numeric, nDepth as numeric) as numeric
    local nValue := 0 as numeric
    local nSign  := 1 as numeric
    local nChild := 0 as numeric

    if aLines[nIdx][3] <> "1"
        return aLines[nIdx][5]
    endIf

    if nDepth >= MAX_DEPTH
        return 0
    endIf

    for nChild := 1 to Len(aLines)
        if nChild <> nIdx .and. !Empty(aLines[nChild][2]) .and. aLines[nChild][2] == aLines[nIdx][1]
            nSign := 1
            if aLines[nChild][4] <> aLines[nIdx][4]
                nSign := -1
            endIf
            nValue += nSign * lineValue(aLines, nChild, nDepth + 1)
        endIf
    next nChild
return nValue

/*/{Protheus.doc} lineLevel
Nível de uma linha: quantas linhas superiores existem acima dela.
@type static function
@author TDash
@since 21/10/2026
@param aLines, array, linhas
@param nIdx, numeric, posição da linha
@return numeric, nível (0 = sem superior)
/*/
static function lineLevel(aLines as array, nIdx as numeric) as numeric
    local nLevel  := 0 as numeric
    local nPos    := 0 as numeric
    local cParent := aLines[nIdx][2] as character

    while !Empty(cParent) .and. nLevel < MAX_DEPTH
        nPos := AScan(aLines, {|x| x[1] == cParent})
        if nPos == 0
            exit
        endIf
        nLevel++
        cParent := aLines[nPos][2]
    endDo
return nLevel
